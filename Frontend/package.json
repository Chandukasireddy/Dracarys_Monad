{
  "name": "streaker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests public/sw.js *.ts *.mjs *.json",
    "format:check": "prettier --check src tests public/sw.js *.ts *.mjs *.json"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "viem": "^2.40.0",
    "wagmi": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
